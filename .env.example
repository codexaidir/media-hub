# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# PORT / HOST: Used by the Express server when running in hosted environments.
PORT=3000
HOST=0.0.0.0

# Frontend (Vite browser bundle)
VITE_SUPABASE_URL="https://ahlsxlolacwqcbouazsn.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server / admin-side Supabase config
SUPABASE_URL="https://ahlsxlolacwqcbouazsn.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional local/Supabase CLI values (only needed if you are using local tooling)
# ANON_KEY="YOUR_LOCAL_SUPABASE_ANON_KEY"
# PUBLISHABLE_KEY="YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY"
# SECRET_KEY="YOUR_LOCAL_SUPABASE_SECRET_KEY"
# SERVICE_ROLE_KEY="YOUR_LOCAL_SUPABASE_SERVICE_ROLE_KEY"
