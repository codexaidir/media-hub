# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used by Supabase auth for site_url and redirect URLs.
# Set this in AWS Amplify environment variables.
APP_URL="https://www.gptimagen.online"

# PORT / HOST: Used by the Express server when running in hosted environments.
PORT=3000
HOST=0.0.0.0

# Frontend (Vite browser bundle) — ANON KEY is safe for client-side use
# Set these in AWS Amplify environment variables for build-time injection.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server / admin-side Supabase config (NEVER expose to client bundle)
# Set these in AWS Amplify environment variables (server-side only, no VITE_ prefix).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ⚠️ SECURITY WARNING ⚠️
# NEVER prefix server secrets with VITE_ — they will be bundled into the client JS.
# NEVER commit real keys to git. Use AWS Amplify env vars or .env (gitignored).
